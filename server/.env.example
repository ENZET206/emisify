# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/emisify?schema=public
# Express port
PORT=4000
# Allowed frontend origins (comma separated) for CORS + CSRF origin check
CLIENT_URL=http://localhost:5173
# Long random string used to sign the auth JWT (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
AUTH_TOKEN_TTL_DAYS=7
# true in production (HTTPS), false for local http://localhost
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Jakarta
# Minimum hours between two progress check-ins on the same challenge
CHALLENGE_CHECKIN_COOLDOWN_HOURS=20
# AI provider: demo | openai | emergent
AI_PROVIDER=demo
# Model name for the provider (e.g. gpt-4o-mini for openai, claude-sonnet-5-5 for emergent)
AI_MODEL=
# API key for AI_PROVIDER=openai (any OpenAI-compatible API)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Only for AI_PROVIDER=emergent (Emergent platform Python bridge)
AI_BRIDGE_URL=
AI_BRIDGE_TOKEN=
# Development demo account created by the seed script
SEED_DEMO_EMAIL=demo@emisify.id
SEED_DEMO_PASSWORD=Emisify123
# Public URL of the frontend, used in password-reset email links
APP_URL=http://localhost:5173
# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
# Authorized redirect URI must be <frontend origin>/auth/google, e.g. http://localhost:5173/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for password-reset emails (e.g. Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, App Password)
# If empty, the reset link is only printed in the server log (development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESET_TOKEN_MINUTES=60
