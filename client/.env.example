# Leave empty to call the API on the same origin (/api). Set e.g. https://api.example.com for a separate API host.
VITE_API_URL=
# Local development: Vite proxies /api to the Express server
VITE_PROXY_TARGET=http://localhost:4000
# Only needed behind an HTTPS reverse proxy (e.g. cloud preview)
VITE_HMR_CLIENT_PORT=
